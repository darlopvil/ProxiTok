{if !isset($item->imagePost)}
{var $cover = $item->video->originCover ?: ($item->video->cover ?: ($item->video->dynamicCover ?: ''))}
{if isset($isSimple)}
	{* RSS: player incrustado con preload=metadata (con "none" los lectores no
	   llegan a cargar nada y el play no dispara). Enlace al post como respaldo. *}
	<video controls preload="metadata" n:attr="poster => $cover ? url_stream($cover) : null">
		<source src="{url_video_stream($item->author->uniqueId, $item->id)}" type="video/mp4" />
	</video>
{else}
<video controls n:attr="autoplay => $isAutoplay, poster => $cover ? url_stream($cover) : null, preload => $cover ? 'none' : 'metadata'">
	<source src="{url_video_stream($item->author->uniqueId, $item->id)}" type="video/mp4" />
</video>
{/if}
{else}
{if isset($isSimple)}
	{foreach $item->imagePost->images as $i => $image}
		<img src="{url_stream($image->imageURL->urlList[0])}" />
	{/foreach}
{else}
	<section class="carousel" aria-label="carousel" Tabindex="0">
	  <div class="slides">
			{foreach $item->imagePost->images as $i => $image}
			<div class="slides-item" id="{$item->id}-image{$i + 1}" tabindex="0">
				<img src="{url_stream($image->imageURL->urlList[0])}" />
			</div>
			{/foreach}
	  </div>
	  <div class="carousel__nav">
			{for $i = 0; $i < count($item->imagePost->images); $i++}
			<a class="slider-nav" href="#{$item->id}-image{$i + 1}">{$i + 1}</a>
			{/for}
	  </div>
	  <div class="carousel__skip-message" id="skip-link" tabindex="0"></div>
	</section>
	{/if}
{/if}