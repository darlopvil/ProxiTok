{* Solo los hashtags que no aparecen ya en la descripción: los que sí están
   salen enlazados en el propio texto y repetirlos aquí era redundante. *}
{var $extra = extra_challenges($challenges, $desc ?? '')}
{if $extra}
<div class="tags mb-1">
	{foreach $extra as $challenge}
		<a class="tag is-primary is-rounded" href="{path('/tag/' . $challenge->title)}">#{$challenge->title}</a>
	{/foreach}
</div>
{/if}