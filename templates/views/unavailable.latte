{layout '../layouts/hero.latte'}

{block content}
	<div class="has-text-centered">
		{if $icon === 'user'}
		<svg xmlns="http://www.w3.org/2000/svg" width="88" height="88" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="opacity:.45;margin-bottom:1.25rem;">
			<circle cx="12" cy="8" r="4"/>
			<path d="M4 20c0-3.5 3.6-6 8-6s8 2.5 8 6"/>
		</svg>
		{else}
		<svg xmlns="http://www.w3.org/2000/svg" width="88" height="88" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="opacity:.45;margin-bottom:1.25rem;">
			<rect x="2" y="7" width="14" height="10" rx="2"/>
			<path d="m16 10 6-3.5v11L16 14z"/>
		</svg>
		{/if}
		<p class="title is-4">{$heading}</p>
		<p class="subtitle is-6 mt-2">{$subtitle}</p>
		<a class="button is-primary mt-3" href="{path('/')}">{$home_label}</a>
	</div>
{/block}